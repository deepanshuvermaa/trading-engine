# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Virtual env
venv/
.venv/

# Secrets & env
.env
.env.*
*.key
*.pem
credentials.json

# Runtime data (regenerates)
data/storage/**
!data/storage/.gitkeep
data/cache/**
!data/cache/.gitkeep
*.parquet

# Runtime logs & reports
logs/
reports/audit/
reports/daily/
reports/simulation/
reports/live/

# Runtime learned-state (brain regenerates / DB is source of truth)
knowledge/rule_stats.json
personas/persona_stats.json
loops/*.jsonl

# .loop runtime experiment records (the daily loop writes these; the seed
# example + the frozen anchors/scaffold stay tracked)
.loop/experiments/*.json
!.loop/experiments/0001-example.json
# Per-machine anchor baseline — the guard self-records it on first run so
# CRLF normalization can't false-trigger a tamper across fresh clones.
.loop/anchors/.hashes.json

# Model caches
*.safetensors
.cache/

# OS
.DS_Store
Thumbs.db
